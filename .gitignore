# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# runtime auth state (WhatsApp/Baileys per-company)
/storage/

# vercel
.vercel

# cache skill Claude Code: dokumen referensi yang di-fetch on-demand sesuai
# skills-lock.json (TETAP di-track -- itu penunjuk versi, bukan cache). Isi
# dokumennya sendiri tidak perlu ikut commit, akan ke-fetch ulang otomatis.
/.claude/skills/
/.agents/

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/public/uploads/
