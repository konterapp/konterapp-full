# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.test
.env.local

# runtime auth state (WhatsApp/Baileys per-company)
/storage/

# vercel
.vercel

# Cache skill Claude Code yang di-fetch otomatis (bukan dibuat manual) sesuai
# skills-lock.json (TETAP di-track -- itu penunjuk versi, bukan cache). Isi
# dokumennya sendiri tidak perlu ikut commit, akan ke-fetch ulang otomatis.
# Sengaja spesifik per-skill (bukan /.claude/skills/ atau /.agents/ secara
# keseluruhan) supaya skill/agent lain yang dibuat manual tetap ter-track.
# .claude/skills/<nama> adalah SYMLINK ke .agents/skills/<nama> (bukan folder
# asli) -- pola berakhiran "/" tidak match ke symlink, jadi tanpa "/" di sini.
/.claude/skills/neon
/.claude/skills/neon-postgres
/.agents/skills/neon/
/.agents/skills/neon-postgres/

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/public/uploads/
