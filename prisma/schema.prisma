generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  name             String    @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  isActive         Boolean   @default(true) @map("is_active")
  password         String    @db.VarChar(255)
  rememberToken    String?   @map("remember_token") @db.VarChar(100)
  referralCode     String?   @unique @map("referral_code") @db.VarChar(20)
  referredByUserId Int?      @map("referred_by_user_id")
  referralBalance  Decimal   @default(0) @map("referral_balance") @db.Decimal(15, 2)

  modelHasRoles       ModelHasRole[]
  companyMemberships  CompanyUser[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  posPurchases        AppPosPurchase[]
  posStockMovements   AppPosStockMovement[]
  posSales            AppPosSale[]
  posCashierShifts    AppPosCashierShift[]
  posPpobTransactions AppPosPpobTransaction[]
  posSaldoMutations   AppPosSaldoMutation[]

  @@map("users")
}

model Administrator {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @db.Char(36)
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("administrators")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @db.Char(36)
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model CompanyInvitationToken {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @db.Char(36)
  companyUserUuid String   @map("company_user_uuid") @db.Char(36)
  tokenHash       String   @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  companyUser CompanyUser @relation(fields: [companyUserUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUserUuid])
  @@map("company_invitation_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @db.Char(36)
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Company {
  uuid      String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships            CompanyUser[]
  roles                  Role[]
  modelHasRoles          ModelHasRole[]
  subscription           CompanySubscription?
  invoices               SubscriptionInvoice[]
  productCategories      AppPosProductCategory[]
  productUnits           AppPosProductUnit[]
  productStocks          AppPosProductStock[]
  productBarcodes        AppPosProductBarcode[]
  productUnitConversions AppPosProductUnitConversion[]
  productBranchPrices    AppPosProductBranchPrice[]
  productImages          AppPosProductImage[]
  purchaseItems          AppPosPurchaseItem[]
  saleItems              AppPosSaleItem[]
  branches               AppPosBranch[]
  products               AppPosProduct[]
  suppliers              AppPosSupplier[]
  purchases              AppPosPurchase[]
  stockMovements         AppPosStockMovement[]
  customers              AppPosCustomer[]
  sales                  AppPosSale[]
  cashierShifts          AppPosCashierShift[]
  ppobProducts           AppPosPpobProduct[]
  ppobTransactions       AppPosPpobTransaction[]
  saldoAccounts          AppPosSaldoAccount[]
  saldoAccountBalances   AppPosSaldoAccountBalance[]
  saldoBalanceBranches   AppPosSaldoAccountBalanceBranch[]
  saldoMutations         AppPosSaldoMutation[]

  @@map("companies")
}

model CompanyUser {
  uuid                 String    @id @default(uuid()) @db.Char(36)
  companyUuid          String    @map("company_uuid") @db.Char(36)
  userId               Int       @map("user_id")
  role                 String?   @db.VarChar(50)
  isDefault            Boolean   @default(false) @map("is_default")
  isActive             Boolean   @default(true) @map("is_active")
  invitationAcceptedAt DateTime? @map("invitation_accepted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company          Company                  @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationTokens CompanyInvitationToken[]

  @@unique([companyUuid, userId], name: "company_user_unique")
  @@index([userId])
  @@map("company_users")
}

model PlanTier {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  code                    String   @unique @db.VarChar(50)
  name                    String   @db.VarChar(255)
  description             String?  @db.VarChar(255)
  maxBranches             Int?     @map("max_branches")
  maxUsers                Int?     @map("max_users")
  maxProducts             Int?     @map("max_products")
  maxTransactionsPerMonth Int?     @map("max_transactions_per_month")
  features                Json?    @default("[]")
  displayOrder            Int      @default(0) @map("display_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  plans Plan[]

  @@map("plan_tiers")
}

model Plan {
  uuid          String   @id @default(uuid()) @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  tierUuid      String   @map("tier_uuid") @db.Char(36)
  billingPeriod String?  @map("billing_period") @db.VarChar(10)
  description   String?  @db.VarChar(255)
  price         Decimal  @default(0) @db.Decimal(15, 2)
  durationDays  Int?     @map("duration_days")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tier          PlanTier              @relation(fields: [tierUuid], references: [uuid])
  subscriptions CompanySubscription[]
  invoices      SubscriptionInvoice[]

  @@index([tierUuid])
  @@map("plans")
}

model CompanySubscription {
  uuid        String    @id @default(uuid()) @db.Char(36)
  companyUuid String    @unique @map("company_uuid") @db.Char(36)
  planUuid    String    @map("plan_uuid") @db.Char(36)
  status      String    @db.VarChar(20)
  startedAt   DateTime  @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  plan    Plan    @relation(fields: [planUuid], references: [uuid], onDelete: Restrict)

  @@index([planUuid])
  @@index([expiresAt])
  @@map("company_subscriptions")
}

model SubscriptionInvoice {
  uuid                   String    @id @default(uuid()) @db.Char(36)
  companyUuid            String    @map("company_uuid") @db.Char(36)
  planUuid               String    @map("plan_uuid") @db.Char(36)
  provider               String    @default("mayar") @db.VarChar(20)
  providerInvoiceId      String    @unique @map("provider_invoice_id") @db.VarChar(100)
  providerTransactionId  String?   @map("provider_transaction_id") @db.VarChar(100)
  amount                 Decimal   @db.Decimal(15, 2)
  couponCode             String?   @map("coupon_code") @db.VarChar(50)
  discountAmount         Decimal?  @map("discount_amount") @db.Decimal(15, 2)
  userId                 Int?      @map("user_id")
  referralCode           String?   @map("referral_code") @db.VarChar(20)
  referralDiscountAmount Decimal?  @map("referral_discount_amount") @db.Decimal(15, 2)
  referralBalanceUsed    Decimal?  @map("referral_balance_used") @db.Decimal(15, 2)
  status                 String    @default("pending") @db.VarChar(20)
  paymentLink            String?   @map("payment_link") @db.Text
  paidAt                 DateTime? @map("paid_at")
  expiredAt              DateTime? @map("expired_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  plan    Plan    @relation(fields: [planUuid], references: [uuid], onDelete: Restrict)

  @@index([companyUuid])
  @@index([status])
  @@map("subscription_invoices")
}

model Coupon {
  uuid            String    @id @default(uuid()) @db.Char(36)
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(255)
  description     String?   @db.VarChar(255)
  planCode        String?   @map("plan_code") @db.VarChar(50)
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  maxDiscount     Decimal?  @map("max_discount") @db.Decimal(15, 2)
  usageLimit      Int?      @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime? @map("starts_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

model ReferralCommission {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @db.Char(36)
  referrerUserId Int      @map("referrer_user_id")
  referredUserId Int      @map("referred_user_id")
  companyUuid    String   @map("company_uuid") @db.Char(36)
  invoiceUuid    String   @unique @map("invoice_uuid") @db.Char(36)
  baseAmount     Decimal  @map("base_amount") @db.Decimal(15, 2)
  amount         Decimal  @db.Decimal(15, 2)
  planCode       String   @map("plan_code") @db.VarChar(50)
  status         String   @default("paid") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([referrerUserId])
  @@index([referredUserId])
  @@map("referral_commissions")
}

model Role {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(255)
  companyUuid  String   @map("company_uuid") @db.Char(36)
  isFullAccess Boolean  @default(false) @map("is_full_access")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roleHasPermissions RoleHasPermission[]
  modelHasRoles      ModelHasRole[]
  company            Company             @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@unique([companyUuid, name], name: "roles_company_uuid_name_unique")
  @@index([companyUuid])
  @@map("app_roles")
}

model ModelHasRole {
  roleId      Int    @map("role_id")
  modelType   String @default("App\\Models\\User") @map("model_type") @db.VarChar(255)
  modelId     Int    @map("model_id")
  companyUuid String @map("company_uuid") @db.Char(36)

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@id([roleId, modelType, modelId, companyUuid])
  @@index([modelId, modelType])
  @@index([companyUuid])
  @@map("app_model_has_roles")
}

model RoleHasPermission {
  permissionName String @map("permission_name") @db.VarChar(255)
  roleId         Int    @map("role_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionName])
  @@map("app_role_has_permissions")
}

// ==================== POS Models ====================

model AppPosProductCategory {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  products AppPosProduct[]

  @@index([companyUuid])
  @@map("app_pos_product_categories")
}

model AppPosProductUnit {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_product_units")
}

model AppPosBranch {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isMain      Boolean  @default(false) @map("is_main")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company          Company                           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  productStocks    AppPosProductStock[]
  productPrices    AppPosProductBranchPrice[]
  purchases        AppPosPurchase[]
  stockMovements   AppPosStockMovement[]
  sales            AppPosSale[]
  cashierShifts    AppPosCashierShift[]
  ppobTransactions AppPosPpobTransaction[]
  saldoMutations   AppPosSaldoMutation[]
  saldoBalances    AppPosSaldoAccountBalanceBranch[]

  @@unique([companyUuid, code])
  @@index([companyUuid])
  @@map("app_pos_branches")
}

model AppPosProduct {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  categoryUuid   String   @map("category_uuid") @db.Char(36)
  name           String   @db.VarChar(255)
  sku            String   @unique @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  minStock       Int      @default(0) @map("min_stock")
  unit           String   @default("pcs") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  category           AppPosProductCategory         @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  stockItems         AppPosProductStock[]
  additionalBarcodes AppPosProductBarcode[]
  unitConversions    AppPosProductUnitConversion[]
  branchPrices       AppPosProductBranchPrice[]
  stockMovements     AppPosStockMovement[]
  images             AppPosProductImage[]
  purchaseItems      AppPosPurchaseItem[]
  saleItems          AppPosSaleItem[]

  @@index([companyUuid])
  @@map("app_pos_products")
}

model AppPosProductBarcode {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  barcode     String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid])
  @@index([companyUuid])
  @@map("app_pos_product_barcodes")
}

model AppPosProductUnitConversion {
  uuid         String   @id @default(uuid()) @db.Char(36)
  companyUuid  String   @map("company_uuid") @db.Char(36)
  productUuid  String   @map("product_uuid") @db.Char(36)
  unit         String   @db.VarChar(20)
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(12, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, unit], name: "product_unit_conversion_unique")
  @@index([productUuid])
  @@index([companyUuid])
  @@map("app_pos_product_unit_conversions")
}

model AppPosProductBranchPrice {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  productUuid    String   @map("product_uuid") @db.Char(36)
  branchUuid     String   @map("branch_uuid") @db.Char(36)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_price_unique")
  @@index([branchUuid])
  @@index([companyUuid])
  @@map("app_pos_product_branch_prices")
}

model AppPosProductImage {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  image       String   @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_product_images")
}

model AppPosProductStock {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  branchUuid  String   @map("branch_uuid") @db.Char(36)
  stock       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_unique")
  @@index([companyUuid])
  @@map("app_pos_product_stocks")
}

model AppPosSupplier {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(255)
  phone         String   @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  purchases AppPosPurchase[]

  @@index([companyUuid])
  @@map("app_pos_suppliers")
}

model AppPosPurchase {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  purchaseNumber String   @unique @map("purchase_number") @db.VarChar(50)
  branchUuid     String   @map("branch_uuid") @db.Char(36)
  supplierUuid   String?  @map("supplier_uuid") @db.Char(36)
  purchaseDate   DateTime @map("purchase_date") @db.Date
  subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus  String   @default("pending") @map("payment_status") @db.VarChar(20)
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company  Company              @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch   AppPosBranch         @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  supplier AppPosSupplier?      @relation(fields: [supplierUuid], references: [uuid], onDelete: SetNull)
  creator  User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items    AppPosPurchaseItem[]

  @@index([companyUuid])
  @@map("app_pos_purchases")
}

model AppPosPurchaseItem {
  uuid         String   @id @default(uuid()) @db.Char(36)
  companyUuid  String   @map("company_uuid") @db.Char(36)
  purchaseUuid String   @map("purchase_uuid") @db.Char(36)
  productUuid  String   @map("product_uuid") @db.Char(36)
  quantity     Int
  purchaseUnit String   @default("pcs") @map("purchase_unit") @db.VarChar(20)
  factorToBase Decimal  @default(1) @map("factor_to_base") @db.Decimal(12, 4)
  quantityBase Int      @default(0) @map("quantity_base")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal     Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  purchase AppPosPurchase @relation(fields: [purchaseUuid], references: [uuid], onDelete: Cascade)
  product  AppPosProduct  @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_purchase_items")
}

model AppPosStockMovement {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  branchUuid    String   @map("branch_uuid") @db.Char(36)
  productUuid   String   @map("product_uuid") @db.Char(36)
  movementType  String   @map("movement_type") @db.VarChar(20) // in, out, adjustment
  quantity      Int
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  referenceType String?  @map("reference_type") @db.VarChar(50) // purchase, sale, adjustment
  referenceUuid String?  @map("reference_uuid") @db.Char(36)
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([productUuid])
  @@map("app_pos_stock_movements")
}

model AppPosCustomer {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company      @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  sales   AppPosSale[]

  @@index([companyUuid])
  @@index([phone])
  @@index([name])
  @@map("app_pos_customers")
}

model AppPosSale {
  uuid              String   @id @default(uuid()) @db.Char(36)
  companyUuid       String   @map("company_uuid") @db.Char(36)
  saleNumber        String   @unique @map("sale_number") @db.VarChar(50)
  branchUuid        String   @map("branch_uuid") @db.Char(36)
  customerUuid      String?  @map("customer_uuid") @db.Char(36)
  paymentMethodUuid String   @map("payment_method_uuid") @db.Char(36)
  saleDate          DateTime @map("sale_date") @db.Date
  subtotal          Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount       Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount        Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount      Decimal  @default(0) @map("change_amount") @db.Decimal(15, 2)
  paymentStatus     String   @default("paid") @map("payment_status") @db.VarChar(20)
  notes             String?  @db.Text
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch        AppPosBranch       @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  customer      AppPosCustomer?    @relation(fields: [customerUuid], references: [uuid], onDelete: SetNull)
  paymentMethod AppPosSaldoAccount @relation(fields: [paymentMethodUuid], references: [uuid], onDelete: Cascade)
  creator       User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items         AppPosSaleItem[]

  @@index([companyUuid])
  @@index([saleDate])
  @@index([paymentStatus])
  @@map("app_pos_sales")
}

model AppPosSaleItem {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  saleUuid    String   @map("sale_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(15, 2)
  subtotal    Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  sale    AppPosSale    @relation(fields: [saleUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_sale_items")
}

model AppPosCashierShift {
  uuid        String    @id @default(uuid()) @db.Char(36)
  companyUuid String    @map("company_uuid") @db.Char(36)
  branchUuid  String    @map("branch_uuid") @db.Char(36)
  userId      Int       @map("user_id")
  status      String    @default("open") @db.VarChar(20)
  openedAt    DateTime  @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  totalSales  Decimal   @default(0) @map("total_sales") @db.Decimal(15, 2)
  notesOpen   String?   @map("notes_open") @db.Text
  notesClose  String?   @map("notes_close") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company      @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
  @@map("app_pos_cashier_shifts")
}

model AppPosPpobProduct {
  uuid                String   @id @default(uuid()) @db.Char(36)
  companyUuid         String   @map("company_uuid") @db.Char(36)
  provider            String   @db.VarChar(20)
  providerProductCode String   @map("provider_product_code") @db.VarChar(100)
  productName         String   @map("product_name") @db.VarChar(255)
  brand               String?  @db.VarChar(100)
  category            String   @db.VarChar(50)
  type                String   @db.VarChar(20)
  sellerName          String?  @map("seller_name") @db.VarChar(255)
  basePrice           Decimal  @default(0) @map("base_price") @db.Decimal(15, 2)
  adminFee            Decimal  @default(0) @map("admin_fee") @db.Decimal(15, 2)
  sellingPrice        Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  digiflazzType       String?  @map("digiflazz_type") @db.VarChar(50)
  buyerProductStatus  Boolean  @default(true) @map("buyer_product_status")
  sellerProductStatus Boolean  @default(true) @map("seller_product_status")
  unlimitedStock      Boolean  @default(false) @map("unlimited_stock")
  stock               Int      @default(0)
  multi               Boolean  @default(false)
  startCutOff         String?  @map("start_cut_off") @db.VarChar(10)
  endCutOff           String?  @map("end_cut_off") @db.VarChar(10)
  desc                String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  providerMetadata    Json?    @map("provider_metadata")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@unique([provider, providerProductCode], name: "provider_product_unique")
  @@index([companyUuid])
  @@index([category])
  @@index([brand])
  @@index([isActive])
  @@map("app_pos_ppob_products")
}

model AppPosPpobTransaction {
  uuid              String   @id @default(uuid()) @db.Char(36)
  companyUuid       String   @map("company_uuid") @db.Char(36)
  branchUuid        String   @map("branch_uuid") @db.Char(36)
  transactionNumber String   @unique @map("transaction_number") @db.VarChar(50)
  type              String   @db.VarChar(20)
  productCode       String   @map("product_code") @db.VarChar(100)
  productName       String   @map("product_name") @db.VarChar(255)
  customerNumber    String   @map("customer_number") @db.VarChar(100)
  customerName      String?  @map("customer_name") @db.VarChar(255)
  amount            Decimal  @default(0) @db.Decimal(15, 2)
  adminFee          Decimal  @default(0) @map("admin_fee") @db.Decimal(15, 2)
  sellingPrice      Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  profit            Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethodUuid String?  @map("payment_method_uuid") @db.Char(36)
  providerReference String?  @map("provider_reference") @db.VarChar(255)
  provider          String   @db.VarChar(20)
  status            String   @db.VarChar(20)
  providerResponse  Json?    @map("provider_response")
  notes             String?  @db.Text
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch        AppPosBranch        @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  paymentMethod AppPosSaldoAccount? @relation(fields: [paymentMethodUuid], references: [uuid], onDelete: SetNull)
  creator       User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([status])
  @@index([createdAt])
  @@map("app_pos_ppob_transactions")
}

model AppPosSaldoAccount {
  uuid            String   @id @default(uuid()) @db.Char(36)
  companyUuid     String   @map("company_uuid") @db.Char(36)
  code            String   @db.VarChar(50)
  name            String   @db.VarChar(100)
  type            String   @default("cash") @db.VarChar(20) // cash, bank, e_wallet, other
  description     String?  @db.Text
  isPaymentMethod Boolean  @default(true) @map("is_payment_method")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company          Company                           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  balances         AppPosSaldoAccountBalance[]
  balanceBranches  AppPosSaldoAccountBalanceBranch[]
  sales            AppPosSale[]
  ppobTransactions AppPosPpobTransaction[]

  @@unique([companyUuid, code])
  @@index([companyUuid])
  @@map("app_pos_saldo_accounts")
}

// Balance akun saldo per kelompok cabang: 1 baris = 1 angka yang dipakai
// bareng oleh sekumpulan cabang tertentu (lihat pivot di bawah). Akun induk
// tidak lagi menyimpan balance; kolom "Saldo" di master list = rollup SUM
// dari semua baris di sini.
model AppPosSaldoAccountBalance {
  uuid             String   @id @default(uuid()) @db.Char(36)
  companyUuid      String   @map("company_uuid") @db.Char(36)
  saldoAccountUuid String   @map("saldo_account_uuid") @db.Char(36)
  name             String?  @db.VarChar(100)
  accountNumber    String?  @map("account_number") @db.VarChar(100)
  accountName      String?  @map("account_name") @db.VarChar(100)
  balance          Decimal  @default(0) @db.Decimal(15, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company      Company                           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  saldoAccount AppPosSaldoAccount                @relation(fields: [saldoAccountUuid], references: [uuid], onDelete: Cascade)
  branchLinks  AppPosSaldoAccountBalanceBranch[]
  mutations    AppPosSaldoMutation[]

  @@index([companyUuid])
  @@index([saldoAccountUuid])
  @@map("app_pos_saldo_account_balances")
}

// Pivot cabang <-> baris balance. Constraint: 1 cabang cuma boleh masuk 1
// baris balance per akun induk yang sama (tidak boleh ambigu).
model AppPosSaldoAccountBalanceBranch {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  companyUuid             String   @map("company_uuid") @db.Char(36)
  saldoAccountUuid        String   @map("saldo_account_uuid") @db.Char(36)
  saldoAccountBalanceUuid String   @map("saldo_account_balance_uuid") @db.Char(36)
  branchUuid              String   @map("branch_uuid") @db.Char(36)
  createdAt               DateTime @default(now()) @map("created_at")

  company             Company                   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  saldoAccount        AppPosSaldoAccount        @relation(fields: [saldoAccountUuid], references: [uuid], onDelete: Cascade)
  saldoAccountBalance AppPosSaldoAccountBalance @relation(fields: [saldoAccountBalanceUuid], references: [uuid], onDelete: Cascade)
  branch              AppPosBranch              @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([saldoAccountUuid, branchUuid])
  @@index([branchUuid])
  @@index([companyUuid])
  @@map("app_pos_saldo_account_balance_branches")
}

model AppPosSaldoMutation {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  companyUuid             String   @map("company_uuid") @db.Char(36)
  saldoAccountBalanceUuid String   @map("saldo_account_balance_uuid") @db.Char(36)
  branchUuid              String?  @map("branch_uuid") @db.Char(36)
  direction               String   @db.VarChar(10) // in, out
  amount                  Decimal  @db.Decimal(15, 2)
  balanceBefore           Decimal  @map("balance_before") @db.Decimal(15, 2)
  balanceAfter            Decimal  @map("balance_after") @db.Decimal(15, 2)
  referenceType           String   @map("reference_type") @db.VarChar(30) // sale, manual_adjustment, opening_balance
  referenceUuid           String?  @map("reference_uuid") @db.Char(36)
  notes                   String?  @db.Text
  createdBy               Int      @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")

  company      Company                   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  saldoBalance AppPosSaldoAccountBalance @relation(fields: [saldoAccountBalanceUuid], references: [uuid], onDelete: Cascade)
  branch       AppPosBranch?             @relation(fields: [branchUuid], references: [uuid], onDelete: SetNull)
  creator      User                      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([saldoAccountBalanceUuid])
  @@index([branchUuid])
  @@map("app_pos_saldo_mutations")
}
