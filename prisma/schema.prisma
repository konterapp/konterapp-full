model AppPosSale {
  uuid                     String   @id @default(uuid()) @db.Char(36)
  companyUuid              String   @map("company_uuid") @db.Char(36)
  saleNumber               String   @unique @map("sale_number") @db.VarChar(50)
  branchUuid               String   @map("branch_uuid") @db.Char(36)
  customerUuid             String?  @map("customer_uuid") @db.Char(36)
  paymentMethodUuid        String   @map("payment_method_uuid") @db.Char(36)
  saleDate                 DateTime @map("sale_date") @db.Date
  subtotal                 Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount           Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount              Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount               Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount             Decimal  @default(0) @map("change_amount") @db.Decimal(15, 2)
  paymentStatus            String   @default("paid") @map("payment_status") @db.VarChar(20)
  notes                    String?  @db.Text
  createdBy                Int      @map("created_by")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  // Diisi HANYA utk sale sintetis komisi Agen Bank -- FK asli (bukan cuma
  // konvensi nomor) supaya bisa ditelusuri balik ke transaksi asalnya.
  // @unique krn 1 transaksi Agen Bank cuma menghasilkan 1 sale.
  bankAgentTransactionUuid String?  @unique @map("bank_agent_transaction_uuid") @db.Char(36)
  // Sama polanya dgn bankAgentTransactionUuid, utk sale sintetis laba PPOB.
  ppobTransactionUuid      String?  @unique @map("ppob_transaction_uuid") @db.Char(36)

  company              Company                     @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch               AppPosBranch                @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  customer             AppPosCustomer?             @relation(fields: [customerUuid], references: [uuid], onDelete: SetNull)
  paymentMethod        AppPosSaldoAccount          @relation(fields: [paymentMethodUuid], references: [uuid], onDelete: Cascade)
  creator              User                        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
