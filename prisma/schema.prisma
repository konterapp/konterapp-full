// Snapshot saldo cabang PADA SAAT buka/tutup shift -- bukan hasil query live
// (kalau live, semua baris riwayat shift di cabang yang sama bakal kelihatan
// sama, percuma buat rekonsiliasi). Diisi sekali saat openShift/closeShift,
// tidak pernah diupdate lagi setelahnya. 1 baris = 1 akun saldo per fase
// (opening/closing) -- tabel terpisah (bukan JSON) supaya bisa di-index &
// diagregasi buat laporan Selisih lintas shift/cabang.
model AppPosCashierShiftSaldoSnapshot {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  companyUuid             String   @map("company_uuid") @db.Char(36)
  shiftUuid               String   @map("shift_uuid") @db.Char(36)
  phase                   String   @db.VarChar(10) // opening, closing
  saldoAccountUuid        String   @map("saldo_account_uuid") @db.Char(36)
  saldoAccountBalanceUuid String   @map("saldo_account_balance_uuid") @db.Char(36)
  balance                 Decimal  @db.Decimal(15, 2) // saldo sistem pd saat snapshot diambil
  actualBalance           Decimal? @map("actual_balance") @db.Decimal(15, 2) // hasil hitung/cek fisik kasir (opsional)
  variance                Decimal? @db.Decimal(15, 2) // actualBalance - balance
  createdAt               DateTime @default(now()) @map("created_at")

  company             Company                   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  shift               AppPosCashierShift        @relation(fields: [shiftUuid], references: [uuid], onDelete: Cascade)
  saldoAccount        AppPosSaldoAccount        @relation(fields: [saldoAccountUuid], references: [uuid], onDelete: Cascade)
  saldoAccountBalance AppPosSaldoAccountBalance @relation(fields: [saldoAccountBalanceUuid], references: [uuid], onDelete: Cascade)

  @@unique([shiftUuid, phase, saldoAccountBalanceUuid])
  @@index([companyUuid])
  @@index([shiftUuid])
  @@index([saldoAccountUuid])
  @@map("app_pos_cashier_shift_saldo_snapshots")
}

// Jenis transaksi PPOB (Pulsa, Token Listrik, PDAM, dst) -- BEDA dari Agen
// Bank yang jenisnya hardcode (deposit/withdrawal/transfer, fixed & sedikit).
// PPOB sengaja dibikin master data dinamis krn jenisnya banyak & terus
// berkembang per operator/provider, jadi tenant yang atur sendiri.
model AppPosPpobTransactionType {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  name          String   @db.VarChar(100)
  cashDirection String   @default("in") @map("cash_direction") @db.VarChar(10) // in, out
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company      Company                  @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  transactions AppPosPpobTransaction[]

  @@unique([companyUuid, name])
  @@index([companyUuid])
  @@map("app_pos_ppob_transaction_types")
}

// Transaksi Server Pulsa/PPOB -- modul terpisah dari Produk (sengaja bukan
// AppPosProduct.kind='ppob'), mirip pola Agen Bank: reuse akun & ledger dari
// domain Saldo (AppPosSaldoAccount.isPpobServer sbg "deposit" server PPOB).
// Tanpa integrasi provider (Digiflazz dkk) di tahap ini -- nominal modal &
// jual diinput manual. Nama ini sengaja dipakai ulang dari stub PPOB lama yg
// sudah dihapus; nama AppPosPpobServerTransaction direservasi utk fitur
// integrasi provider yang direncanakan menyusul.
model AppPosPpobTransaction {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  companyUuid             String   @map("company_uuid") @db.Char(36)
  branchUuid              String   @map("branch_uuid") @db.Char(36)
  saldoAccountUuid        String   @map("saldo_account_uuid") @db.Char(36)
  saldoAccountBalanceUuid String   @map("saldo_account_balance_uuid") @db.Char(36)
  transactionTypeUuid     String   @map("transaction_type_uuid") @db.Char(36)
  transactionNumber       String   @unique @map("transaction_number") @db.VarChar(50)
  // Snapshot dari AppPosPpobTransactionType.cashDirection saat transaksi
  // dibuat -- supaya riwayat tetap benar walau tipe-nya diedit belakangan.
  cashDirection           String   @map("cash_direction") @db.VarChar(10)
  accountReference        String?  @map("account_reference") @db.VarChar(100) // no. HP/meter/ID pelanggan tujuan
  baseAmount              Decimal  @map("base_amount") @db.Decimal(15, 2) // modal
  sellingAmount           Decimal  @map("selling_amount") @db.Decimal(15, 2) // harga jual ke pelanggan
  adminFee                Decimal  @default(0) @map("admin_fee") @db.Decimal(15, 2) // beban ke server/provider
  paymentMethodUuid       String   @map("payment_method_uuid") @db.Char(36) // akun saldo yg kena mutasi kas
  paidAmount              Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount            Decimal  @default(0) @map("change_amount") @db.Decimal(15, 2)
  notes                   String?  @db.Text
  createdBy               Int      @map("created_by")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  company             Company                   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch              AppPosBranch              @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  saldoAccount        AppPosSaldoAccount        @relation("PpobTransactionAccount", fields: [saldoAccountUuid], references: [uuid], onDelete: Cascade)
  saldoAccountBalance AppPosSaldoAccountBalance @relation(fields: [saldoAccountBalanceUuid], references: [uuid], onDelete: Cascade)
  transactionType     AppPosPpobTransactionType @relation(fields: [transactionTypeUuid], references: [uuid], onDelete: Cascade)
  paymentMethod       AppPosSaldoAccount        @relation("PpobTransactionPaymentMethod", fields: [paymentMethodUuid], references: [uuid], onDelete: Cascade)
  creator             User                      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  sale                AppPosSale?

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([saldoAccountUuid])
  @@index([paymentMethodUuid])
  @@index([transactionTypeUuid])
  @@map("app_pos_ppob_transactions")
}

model AppPosSaldoAccount {
  uuid            String   @id @default(uuid()) @db.Char(36)
  companyUuid     String   @map("company_uuid") @db.Char(36)
  code            String   @db.VarChar(50)
  name            String   @db.VarChar(100)
  type            String   @default("cash") @db.VarChar(20) // cash, bank, e_wallet, other
  description     String?  @db.Text
  isPaymentMethod Boolean  @default(true) @map("is_payment_method")
  isActive        Boolean  @default(true) @map("is_active")
  showInShift     Boolean  @default(true) @map("show_in_shift")
  sortOrder       Int      @default(0) @map("sort_order")
  // Independen dari `type` -- akun apa pun (DANA, BRI, dst) bisa dipakai
  // buat transaksi Agen Bank, bukan cuma akun ber-"tipe" bank.
  isBankAgent     Boolean  @default(false) @map("is_bank_agent")
  // Sama polanya dgn isBankAgent -- menandai akun ini boleh dipakai sbg
  // "server"/deposit PPOB (Server Pulsa), reuse infrastruktur akun & balance
  // saldo yang sama, bukan tabel akun terpisah.
  isPpobServer    Boolean  @default(false) @map("is_ppob_server")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company                              Company                           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  balances                             AppPosSaldoAccountBalance[]
  balanceBranches                      AppPosSaldoAccountBalanceBranch[]
  sales                                AppPosSale[]
  bankAgentTransactions                AppPosBankAgentTransaction[]      @relation("BankAgentTransactionAccount")
  bankAgentTransactionsAsPaymentMethod AppPosBankAgentTransaction[]      @relation("BankAgentTransactionPaymentMethod")
  ppobTransactions                     AppPosPpobTransaction[]           @relation("PpobTransactionAccount")
  ppobTransactionsAsPaymentMethod      AppPosPpobTransaction[]           @relation("PpobTransactionPaymentMethod")
  cashierShiftSaldoSnapshots           AppPosCashierShiftSaldoSnapshot[]

  @@unique([companyUuid, code])
  @@index([companyUuid])
  @@map("app_pos_saldo_accounts")
}

// Balance akun saldo per kelompok cabang: 1 baris = 1 angka yang dipakai
