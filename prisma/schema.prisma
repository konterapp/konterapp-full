generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  name             String    @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  isActive         Boolean   @default(true) @map("is_active")
  password         String    @db.VarChar(255)
  rememberToken    String?   @map("remember_token") @db.VarChar(100)
  referralCode     String?   @unique @map("referral_code") @db.VarChar(20)
  referredByUserId Int?      @map("referred_by_user_id")
  referralBalance  Decimal   @default(0) @map("referral_balance") @db.Decimal(15, 2)

  modelHasRoles            ModelHasRole[]
  companyMemberships       CompanyUser[]
  emailVerifications       EmailVerificationToken[]
  passwordResets           PasswordResetToken[]
  posPurchases             AppPosPurchase[]
  posStockMovements        AppPosStockMovement[]
  posSales                 AppPosSale[]
  posCashierShifts         AppPosCashierShift[]
  posSaldoMutations        AppPosSaldoMutation[]
  posBankAgentTransactions AppPosBankAgentTransaction[]
  posPpobTransactions      AppPosPpobTransaction[]

  @@map("users")
}

model Administrator {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @db.Char(36)
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("administrators")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @db.Char(36)
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model CompanyInvitationToken {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @db.Char(36)
  companyUserUuid String   @map("company_user_uuid") @db.Char(36)
  tokenHash       String   @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  companyUser CompanyUser @relation(fields: [companyUserUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUserUuid])
  @@map("company_invitation_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @db.Char(36)
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Company {
  uuid      String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships                CompanyUser[]
  memberBranches             CompanyUserBranch[]
  roles                      Role[]
  modelHasRoles              ModelHasRole[]
  subscription               CompanySubscription?
  invoices                   SubscriptionInvoice[]
  productCategories          AppPosProductCategory[]
  productUnits               AppPosProductUnit[]
  productStocks              AppPosProductStock[]
  productBarcodes            AppPosProductBarcode[]
  productUnitConversions     AppPosProductUnitConversion[]
  productBranchPrices        AppPosProductBranchPrice[]
  productImages              AppPosProductImage[]
  purchaseItems              AppPosPurchaseItem[]
  saleItems                  AppPosSaleItem[]
  branches                   AppPosBranch[]
  products                   AppPosProduct[]
  suppliers                  AppPosSupplier[]
  purchases                  AppPosPurchase[]
  stockMovements             AppPosStockMovement[]
  customers                  AppPosCustomer[]
  sales                      AppPosSale[]
  cashierShifts              AppPosCashierShift[]
  cashierShiftSaldoSnapshots AppPosCashierShiftSaldoSnapshot[]
  saldoAccounts              AppPosSaldoAccount[]
  saldoAccountBalances       AppPosSaldoAccountBalance[]
  saldoBalanceBranches       AppPosSaldoAccountBalanceBranch[]
  saldoMutations             AppPosSaldoMutation[]
  bankAgentTransactions      AppPosBankAgentTransaction[]
  bankAgentTransactionTypes  AppPosBankAgentTransactionType[]
  ppobTransactionTypes       AppPosPpobTransactionType[]
  ppobTransactions           AppPosPpobTransaction[]

  @@map("companies")
}

model CompanyUser {
  uuid                 String    @id @default(uuid()) @db.Char(36)
  companyUuid          String    @map("company_uuid") @db.Char(36)
  userId               Int       @map("user_id")
  role                 String?   @db.VarChar(50)
  isDefault            Boolean   @default(false) @map("is_default")
  isActive             Boolean   @default(true) @map("is_active")
  invitationAcceptedAt DateTime? @map("invitation_accepted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  company          Company                  @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationTokens CompanyInvitationToken[]
  branches         CompanyUserBranch[]

  @@unique([companyUuid, userId], name: "company_user_unique")
  @@index([userId])
  @@map("company_users")
}

/**
 * Pembatasan cabang untuk user dengan role yang tidak punya akses penuh ke
 * cabang (tidak punya permission pos.branch.index). Kalau user tidak punya
 * baris di sini sama sekali, dia dianggap tidak dibatasi (bebas pilih cabang
 * mana pun) -- baris di sini baru dibuat kalau role-nya memang dibatasi.
 */
model CompanyUserBranch {
  uuid            String   @id @default(uuid()) @db.Char(36)
  companyUuid     String   @map("company_uuid") @db.Char(36)
  companyUserUuid String   @map("company_user_uuid") @db.Char(36)
  branchUuid      String   @map("branch_uuid") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")

  company     Company      @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  companyUser CompanyUser  @relation(fields: [companyUserUuid], references: [uuid], onDelete: Cascade)
  branch      AppPosBranch @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([companyUserUuid, branchUuid], name: "company_user_branch_unique")
  @@index([companyUuid])
  @@index([branchUuid])
  @@map("company_user_branches")
}

model PlanTier {
  uuid                    String   @id @default(uuid()) @db.Char(36)
  code                    String   @unique @db.VarChar(50)
  name                    String   @db.VarChar(255)
  description             String?  @db.VarChar(255)
  maxBranches             Int?     @map("max_branches")
  maxUsers                Int?     @map("max_users")
  maxProducts             Int?     @map("max_products")
  maxTransactionsPerMonth Int?     @map("max_transactions_per_month")
  features                Json?    @default("[]")
  displayOrder            Int      @default(0) @map("display_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  plans Plan[]

  @@map("plan_tiers")
}

model Plan {
  uuid          String   @id @default(uuid()) @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  tierUuid      String   @map("tier_uuid") @db.Char(36)
  billingPeriod String?  @map("billing_period") @db.VarChar(10)
  description   String?  @db.VarChar(255)
  price         Decimal  @default(0) @db.Decimal(15, 2)
  durationDays  Int?     @map("duration_days")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tier          PlanTier              @relation(fields: [tierUuid], references: [uuid])
  subscriptions CompanySubscription[]
  invoices      SubscriptionInvoice[]

  @@index([tierUuid])
  @@map("plans")
}

model CompanySubscription {
  uuid        String    @id @default(uuid()) @db.Char(36)
  companyUuid String    @unique @map("company_uuid") @db.Char(36)
  planUuid    String    @map("plan_uuid") @db.Char(36)
  status      String    @db.VarChar(20)
  startedAt   DateTime  @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  plan    Plan    @relation(fields: [planUuid], references: [uuid], onDelete: Restrict)

  @@index([planUuid])
  @@index([expiresAt])
  @@map("company_subscriptions")
}

model SubscriptionInvoice {
  uuid                   String    @id @default(uuid()) @db.Char(36)
  companyUuid            String    @map("company_uuid") @db.Char(36)
  planUuid               String    @map("plan_uuid") @db.Char(36)
  provider               String    @default("mayar") @db.VarChar(20)
  providerInvoiceId      String    @unique @map("provider_invoice_id") @db.VarChar(100)
  providerTransactionId  String?   @map("provider_transaction_id") @db.VarChar(100)
  amount                 Decimal   @db.Decimal(15, 2)
  couponCode             String?   @map("coupon_code") @db.VarChar(50)
  discountAmount         Decimal?  @map("discount_amount") @db.Decimal(15, 2)
  userId                 Int?      @map("user_id")
  referralCode           String?   @map("referral_code") @db.VarChar(20)
  referralDiscountAmount Decimal?  @map("referral_discount_amount") @db.Decimal(15, 2)
  referralBalanceUsed    Decimal?  @map("referral_balance_used") @db.Decimal(15, 2)
  status                 String    @default("pending") @db.VarChar(20)
  paymentLink            String?   @map("payment_link") @db.Text
  paidAt                 DateTime? @map("paid_at")
  expiredAt              DateTime? @map("expired_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  plan    Plan    @relation(fields: [planUuid], references: [uuid], onDelete: Restrict)

  @@index([companyUuid])
  @@index([status])
  @@map("subscription_invoices")
}

model Coupon {
  uuid            String    @id @default(uuid()) @db.Char(36)
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(255)
  description     String?   @db.VarChar(255)
  planCode        String?   @map("plan_code") @db.VarChar(50)
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  maxDiscount     Decimal?  @map("max_discount") @db.Decimal(15, 2)
  usageLimit      Int?      @map("usage_limit")
  usedCount       Int       @default(0) @map("used_count")
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime? @map("starts_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

model ReferralCommission {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @db.Char(36)
  referrerUserId Int      @map("referrer_user_id")
  referredUserId Int      @map("referred_user_id")
  companyUuid    String   @map("company_uuid") @db.Char(36)
  invoiceUuid    String   @unique @map("invoice_uuid") @db.Char(36)
  baseAmount     Decimal  @map("base_amount") @db.Decimal(15, 2)
  amount         Decimal  @db.Decimal(15, 2)
  planCode       String   @map("plan_code") @db.VarChar(50)
  status         String   @default("paid") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([referrerUserId])
  @@index([referredUserId])
  @@map("referral_commissions")
}

model Role {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(255)
  companyUuid  String   @map("company_uuid") @db.Char(36)
  isFullAccess Boolean  @default(false) @map("is_full_access")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roleHasPermissions RoleHasPermission[]
  modelHasRoles      ModelHasRole[]
  company            Company             @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@unique([companyUuid, name], name: "roles_company_uuid_name_unique")
  @@index([companyUuid])
  @@map("app_roles")
}

model ModelHasRole {
  roleId      Int    @map("role_id")
  modelType   String @default("App\\Models\\User") @map("model_type") @db.VarChar(255)
  modelId     Int    @map("model_id")
  companyUuid String @map("company_uuid") @db.Char(36)

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@id([roleId, modelType, modelId, companyUuid])
  @@index([modelId, modelType])
  @@index([companyUuid])
  @@map("app_model_has_roles")
}

model RoleHasPermission {
  permissionName String @map("permission_name") @db.VarChar(255)
  roleId         Int    @map("role_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionName])
  @@map("app_role_has_permissions")
}

// ==================== POS Models ====================

model AppPosProductCategory {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  products AppPosProduct[]

  @@index([companyUuid])
  @@map("app_pos_product_categories")
}

model AppPosProductUnit {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_product_units")
}

model AppPosBranch {
  uuid               String   @id @default(uuid()) @db.Char(36)
  companyUuid        String   @map("company_uuid") @db.Char(36)
  code               String   @db.VarChar(20)
  name               String   @db.VarChar(255)
  address            String?  @db.Text
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(255)
  isActive           Boolean  @default(true) @map("is_active")
  isMain             Boolean  @default(false) @map("is_main")
  maxConcurrentUsers Int      @default(1) @map("max_concurrent_users")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company               Company                           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  productStocks         AppPosProductStock[]
  productPrices         AppPosProductBranchPrice[]
  purchases             AppPosPurchase[]
  stockMovements        AppPosStockMovement[]
  sales                 AppPosSale[]
  cashierShifts         AppPosCashierShift[]
  saldoMutations        AppPosSaldoMutation[]
  saldoBalances         AppPosSaldoAccountBalanceBranch[]
  memberAccess          CompanyUserBranch[]
  bankAgentTransactions AppPosBankAgentTransaction[]
  ppobTransactions      AppPosPpobTransaction[]

  @@unique([companyUuid, code])
  @@index([companyUuid])
  @@map("app_pos_branches")
}

model AppPosProduct {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  categoryUuid   String   @map("category_uuid") @db.Char(36)
  name           String   @db.VarChar(255)
  sku            String   @unique @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  minStock       Int      @default(0) @map("min_stock")
  unit           String   @default("pcs") @db.VarChar(20)
  // Tipe produk: 'barang' (fisik, pakai stok & pembelian seperti biasa),
  // 'digital'/'jasa' (fixed price, qty=1, tanpa stok fisik), 'ppob' (produk
  // PPOB generasi baru -- katalog & harga tetap, dijual lewat alur Penjualan
  // yang sama, TANPA integrasi provider di tahap ini; beda dgn Agen Bank yang
  // variable amount tanpa qty, makanya modul terpisah bukan produk).
  kind           String   @default("barang") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  // Produk yg dibuat otomatis oleh sistem (mis. "Komisi Agen Bank") --
  // disembunyikan dari listing produk biasa, cuma dipakai internal supaya
  // laporan omzet/Riwayat bisa baca 1 sumber (app_pos_sales) tanpa UNION.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  category           AppPosProductCategory         @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  stockItems         AppPosProductStock[]
  additionalBarcodes AppPosProductBarcode[]
  unitConversions    AppPosProductUnitConversion[]
  branchPrices       AppPosProductBranchPrice[]
  stockMovements     AppPosStockMovement[]
  images             AppPosProductImage[]
  purchaseItems      AppPosPurchaseItem[]
  saleItems          AppPosSaleItem[]

  @@index([companyUuid])
  @@map("app_pos_products")
}

model AppPosProductBarcode {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  barcode     String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid])
  @@index([companyUuid])
  @@map("app_pos_product_barcodes")
}

model AppPosProductUnitConversion {
  uuid         String   @id @default(uuid()) @db.Char(36)
  companyUuid  String   @map("company_uuid") @db.Char(36)
  productUuid  String   @map("product_uuid") @db.Char(36)
  unit         String   @db.VarChar(20)
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(12, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, unit], name: "product_unit_conversion_unique")
  @@index([productUuid])
  @@index([companyUuid])
  @@map("app_pos_product_unit_conversions")
}

model AppPosProductBranchPrice {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  productUuid    String   @map("product_uuid") @db.Char(36)
  branchUuid     String   @map("branch_uuid") @db.Char(36)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_price_unique")
  @@index([branchUuid])
  @@index([companyUuid])
  @@map("app_pos_product_branch_prices")
}

model AppPosProductImage {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  image       String   @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("app_pos_product_images")
}

model AppPosProductStock {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  branchUuid  String   @map("branch_uuid") @db.Char(36)
  stock       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  product AppPosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  AppPosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_unique")
  @@index([companyUuid])
  @@map("app_pos_product_stocks")
}

model AppPosSupplier {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(255)
  phone         String   @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  purchases AppPosPurchase[]

  @@index([companyUuid])
  @@map("app_pos_suppliers")
}

model AppPosPurchase {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
