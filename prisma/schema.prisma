generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  sourceDb        String?   @map("source_db") @db.VarChar(50)
  sourceId        String?   @map("source_id") @db.VarChar(50)
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  password        String    @db.VarChar(255)
  rememberToken   String?   @map("remember_token") @db.VarChar(100)

  profile             UserProfile?
  modelHasRoles       ModelHasRole[]
  companyMemberships  CompanyUser[]
  berita              Berita[]
  posPurchases        PosPurchase[]
  posStockMovements   PosStockMovement[]
  posSales            PosSale[]
  posCashierShifts    PosCashierShift[]
  posPpobTransactions PosPpobTransaction[]

  @@unique([sourceDb, sourceId], name: "users_source_db_source_id_unique")
  @@map("users")
}

model Company {
  uuid      String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       CompanyUser[]
  productCategories PosProductCategory[]
  productUnits      PosProductUnit[]
  branches          PosBranch[]
  products          PosProduct[]
  suppliers         PosSupplier[]
  purchases         PosPurchase[]
  stockMovements    PosStockMovement[]
  paymentMethods    PosPaymentMethod[]
  customers         PosCustomer[]
  sales             PosSale[]
  cashierShifts     PosCashierShift[]
  ppobProducts      PosPpobProduct[]
  ppobTransactions  PosPpobTransaction[]

  @@map("companies")
}

model CompanyUser {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  userId      Int      @map("user_id")
  role        String?  @db.VarChar(50)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyUuid, userId], name: "company_user_unique")
  @@index([userId])
  @@map("company_users")
}

model UserProfile {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  sourceDb          String?   @map("source_db") @db.VarChar(50)
  sourceId          String?   @map("source_id") @db.VarChar(50)
  userId            Int       @unique @map("user_id")
  userType          Int?      @map("user_type") @db.SmallInt
  adminScope        String?   @map("admin_scope") @db.VarChar(50)
  countryId         Int?      @map("country_id")
  provinceId        Int?      @map("province_id")
  cityId            Int?      @map("city_id")
  districtId        Int?      @map("district_id")
  villageId         Int?      @map("village_id")
  phone             String?   @db.VarChar(20)
  address           String?   @db.Text
  avatar            String?   @db.Text
  avatarS3Sync      Boolean?  @map("avatar_s3_sync")
  title             String?   @db.VarChar(255)
  workUnit          String?   @map("work_unit") @db.VarChar(255)
  company           String?   @db.VarChar(255)
  phoneWithoutDc    String?   @map("phone_without_dc") @db.VarChar(255)
  dc                String?   @db.VarChar(255)
  iso               String?   @db.VarChar(255)
  fcm               String?   @db.Text
  companyLogo       String?   @map("company_logo") @db.Text
  companyLogoS3Sync Boolean?  @map("company_logo_s3_sync")
  description       String?   @db.Text
  wilayahKode       String?   @map("wilayah_kode") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryId], name: "idx_user_profiles_country_id")
  @@index([provinceId], name: "idx_user_profiles_province_id")
  @@index([cityId], name: "idx_user_profiles_city_id")
  @@index([userType, provinceId], name: "idx_user_profiles_type_province")
  @@index([provinceId, userType], name: "idx_user_profiles_province_type")
  @@index([adminScope])
  @@index([userType, adminScope])
  @@map("user_profiles")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleHasPermissions RoleHasPermission[]
  modelHasRoles      ModelHasRole[]

  @@unique([name, guardName], name: "roles_name_guard_name_unique")
  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleHasPermissions  RoleHasPermission[]
  modelHasPermissions ModelHasPermission[]

  @@unique([name, guardName], name: "permissions_name_guard_name_unique")
  @@map("permissions")
}

model ModelHasRole {
  roleId    Int    @map("role_id")
  modelType String @default("App\\\\Models\\\\User") @map("model_type") @db.VarChar(255)
  modelId   Int    @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([roleId, modelType, modelId])
  @@index([modelId, modelType], name: "model_has_roles_model_id_model_type_index")
  @@map("model_has_roles")
}

model ModelHasPermission {
  permissionId Int    @map("permission_id")
  modelType    String @default("App\\\\Models\\\\User") @map("model_type") @db.VarChar(255)
  modelId      Int    @map("model_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionId, modelType, modelId])
  @@index([modelId, modelType], name: "model_has_permissions_model_id_model_type_index")
  @@map("model_has_permissions")
}

model Berita {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.Text
  image       String?   @db.VarChar(255)
  tags        Json?
  publishedAt DateTime? @map("published_at") @db.Date
  isPublished Boolean   @default(false) @map("is_published")
  isDraft     Boolean   @default(false) @map("is_draft")
  newsType    String?   @map("news_type") @db.VarChar(50)
  category    String?   @db.VarChar(50)
  views       Int       @default(0)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  creator User? @relation(fields: [createdBy], references: [id])

  @@index([slug])
  @@index([isPublished])
  @@index([createdBy])
  @@map("berita")
}

model RoleHasPermission {
  permissionId Int @map("permission_id")
  roleId       Int @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

// ==================== POS Models ====================

model PosProductCategory {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company  Company      @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  products PosProduct[]

  @@index([companyUuid])
  @@map("pos_product_categories")
}

model PosProductUnit {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@map("pos_product_units")
}

model PosBranch {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isMain      Boolean  @default(false) @map("is_main")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company          Company                @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  productStocks    PosProductStock[]
  productPrices    PosProductBranchPrice[]
  purchases        PosPurchase[]
  stockMovements   PosStockMovement[]
  sales            PosSale[]
  cashierShifts    PosCashierShift[]
  ppobTransactions PosPpobTransaction[]

  @@index([companyUuid])
  @@map("pos_branches")
}

model PosProduct {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  categoryUuid   String   @map("category_uuid") @db.Char(36)
  name           String   @db.VarChar(255)
  sku            String   @unique @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  minStock       Int      @default(0) @map("min_stock")
  unit           String   @default("pcs") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company            Company                    @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  category           PosProductCategory         @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  stockItems         PosProductStock[]
  additionalBarcodes PosProductBarcode[]
  unitConversions    PosProductUnitConversion[]
  branchPrices       PosProductBranchPrice[]
  stockMovements     PosStockMovement[]
  images             PosProductImage[]
  purchaseItems      PosPurchaseItem[]
  saleItems          PosSaleItem[]

  @@index([companyUuid])
  @@map("pos_products")
}

model PosProductBarcode {
  uuid        String   @id @default(uuid()) @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  barcode     String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid])
  @@map("pos_product_barcodes")
}

model PosProductUnitConversion {
  uuid         String   @id @default(uuid()) @db.Char(36)
  productUuid  String   @map("product_uuid") @db.Char(36)
  unit         String   @db.VarChar(20)
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(12, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, unit], name: "product_unit_conversion_unique")
  @@index([productUuid])
  @@map("pos_product_unit_conversions")
}

model PosProductBranchPrice {
  uuid           String   @id @default(uuid()) @db.Char(36)
  productUuid    String   @map("product_uuid") @db.Char(36)
  branchUuid     String   @map("branch_uuid") @db.Char(36)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal  @default(0) @map("wholesale_price") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  PosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_price_unique")
  @@index([branchUuid])
  @@map("pos_product_branch_prices")
}

model PosProductImage {
  uuid        String   @id @default(uuid()) @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  image       String   @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@map("pos_product_images")
}

model PosProductStock {
  uuid        String   @id @default(uuid()) @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  branchUuid  String   @map("branch_uuid") @db.Char(36)
  stock       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  branch  PosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)

  @@unique([productUuid, branchUuid], name: "product_branch_unique")
  @@map("pos_product_stocks")
}

model PosSupplier {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(255)
  phone         String   @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  purchases PosPurchase[]

  @@index([companyUuid])
  @@map("pos_suppliers")
}

model PosPurchase {
  uuid           String   @id @default(uuid()) @db.Char(36)
  companyUuid    String   @map("company_uuid") @db.Char(36)
  purchaseNumber String   @unique @map("purchase_number") @db.VarChar(50)
  branchUuid     String   @map("branch_uuid") @db.Char(36)
  supplierUuid   String?  @map("supplier_uuid") @db.Char(36)
  purchaseDate   DateTime @map("purchase_date") @db.Date
  subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus  String   @default("pending") @map("payment_status") @db.VarChar(20)
  notes          String?  @db.Text
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch   PosBranch         @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  supplier PosSupplier?      @relation(fields: [supplierUuid], references: [uuid], onDelete: SetNull)
  creator  User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items    PosPurchaseItem[]

  @@index([companyUuid])
  @@map("pos_purchases")
}

model PosPurchaseItem {
  uuid         String   @id @default(uuid()) @db.Char(36)
  purchaseUuid String   @map("purchase_uuid") @db.Char(36)
  productUuid  String   @map("product_uuid") @db.Char(36)
  quantity     Int
  purchaseUnit String   @default("pcs") @map("purchase_unit") @db.VarChar(20)
  factorToBase Decimal  @default(1) @map("factor_to_base") @db.Decimal(12, 4)
  quantityBase Int      @default(0) @map("quantity_base")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal     Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchase PosPurchase @relation(fields: [purchaseUuid], references: [uuid], onDelete: Cascade)
  product  PosProduct  @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@map("pos_purchase_items")
}

model PosStockMovement {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  branchUuid    String   @map("branch_uuid") @db.Char(36)
  productUuid   String   @map("product_uuid") @db.Char(36)
  movementType  String   @map("movement_type") @db.VarChar(20) // in, out, adjustment
  quantity      Int
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  referenceType String?  @map("reference_type") @db.VarChar(50) // purchase, sale, adjustment
  referenceUuid String?  @map("reference_uuid") @db.Char(36)
  notes         String?  @db.Text
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company    @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch  PosBranch  @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)
  creator User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([productUuid])
  @@map("pos_stock_movements")
}

model PosPaymentMethod {
  uuid          String   @id @default(uuid()) @db.Char(36)
  companyUuid   String   @map("company_uuid") @db.Char(36)
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  type          String   @default("cash") @db.VarChar(20)
  accountNumber String?  @map("account_number") @db.VarChar(100)
  accountName   String?  @map("account_name") @db.VarChar(100)
  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company          Company              @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  sales            PosSale[]
  ppobTransactions PosPpobTransaction[]

  @@index([companyUuid])
  @@map("pos_payment_methods")
}

model PosCustomer {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  name        String   @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  sales PosSale[]

  @@index([companyUuid])
  @@index([phone])
  @@index([name])
  @@map("pos_customers")
}

model PosSale {
  uuid              String   @id @default(uuid()) @db.Char(36)
  companyUuid       String   @map("company_uuid") @db.Char(36)
  saleNumber        String   @unique @map("sale_number") @db.VarChar(50)
  branchUuid        String   @map("branch_uuid") @db.Char(36)
  customerUuid      String?  @map("customer_uuid") @db.Char(36)
  paymentMethodUuid String   @map("payment_method_uuid") @db.Char(36)
  saleDate          DateTime @map("sale_date") @db.Date
  subtotal          Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalAmount       Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount        Decimal  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount      Decimal  @default(0) @map("change_amount") @db.Decimal(15, 2)
  paymentStatus     String   @default("paid") @map("payment_status") @db.VarChar(20)
  notes             String?  @db.Text
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch        PosBranch        @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  customer      PosCustomer?     @relation(fields: [customerUuid], references: [uuid], onDelete: SetNull)
  paymentMethod PosPaymentMethod @relation(fields: [paymentMethodUuid], references: [uuid], onDelete: Cascade)
  creator       User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items         PosSaleItem[]

  @@index([companyUuid])
  @@index([saleDate])
  @@index([paymentStatus])
  @@map("pos_sales")
}

model PosSaleItem {
  uuid        String   @id @default(uuid()) @db.Char(36)
  saleUuid    String   @map("sale_uuid") @db.Char(36)
  productUuid String   @map("product_uuid") @db.Char(36)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(15, 2)
  subtotal    Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sale    PosSale    @relation(fields: [saleUuid], references: [uuid], onDelete: Cascade)
  product PosProduct @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@map("pos_sale_items")
}

model PosCashierShift {
  uuid        String   @id @default(uuid()) @db.Char(36)
  companyUuid String   @map("company_uuid") @db.Char(36)
  branchUuid  String   @map("branch_uuid") @db.Char(36)
  userId      Int      @map("user_id")
  status      String   @default("open") @db.VarChar(20)
  openedAt    DateTime @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  openingCash Decimal  @default(0) @map("opening_cash") @db.Decimal(15, 2)
  totalSales  Decimal  @default(0) @map("total_sales") @db.Decimal(15, 2)
  expectedCash Decimal @default(0) @map("expected_cash") @db.Decimal(15, 2)
  closingCash Decimal? @map("closing_cash") @db.Decimal(15, 2)
  variance    Decimal  @default(0) @db.Decimal(15, 2)
  notesOpen   String?  @map("notes_open") @db.Text
  notesClose  String?  @map("notes_close") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company  @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch  PosBranch @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
  @@map("pos_cashier_shifts")
}

model PosPpobProduct {
  uuid                String   @id @default(uuid()) @db.Char(36)
  companyUuid         String   @map("company_uuid") @db.Char(36)
  provider            String   @db.VarChar(20)
  providerProductCode String   @map("provider_product_code") @db.VarChar(100)
  productName         String   @map("product_name") @db.VarChar(255)
  brand               String?  @db.VarChar(100)
  category            String   @db.VarChar(50)
  type                String   @db.VarChar(20)
  sellerName          String?  @map("seller_name") @db.VarChar(255)
  basePrice           Decimal  @default(0) @map("base_price") @db.Decimal(15, 2)
  adminFee            Decimal  @default(0) @map("admin_fee") @db.Decimal(15, 2)
  sellingPrice        Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  digiflazzType       String?  @map("digiflazz_type") @db.VarChar(50)
  buyerProductStatus  Boolean  @default(true) @map("buyer_product_status")
  sellerProductStatus Boolean  @default(true) @map("seller_product_status")
  unlimitedStock      Boolean  @default(false) @map("unlimited_stock")
  stock               Int      @default(0)
  multi               Boolean  @default(false)
  startCutOff         String?  @map("start_cut_off") @db.VarChar(10)
  endCutOff           String?  @map("end_cut_off") @db.VarChar(10)
  desc                String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  providerMetadata    Json?    @map("provider_metadata")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)

  @@index([companyUuid])
  @@unique([provider, providerProductCode], name: "provider_product_unique")
  @@index([category])
  @@index([brand])
  @@index([isActive])
  @@map("pos_ppob_products")
}

model PosPpobTransaction {
  uuid              String   @id @default(uuid()) @db.Char(36)
  companyUuid       String   @map("company_uuid") @db.Char(36)
  branchUuid        String   @map("branch_uuid") @db.Char(36)
  transactionNumber String   @unique @map("transaction_number") @db.VarChar(50)
  type              String   @db.VarChar(20)
  productCode       String   @map("product_code") @db.VarChar(100)
  productName       String   @map("product_name") @db.VarChar(255)
  customerNumber    String   @map("customer_number") @db.VarChar(100)
  customerName      String?  @map("customer_name") @db.VarChar(255)
  amount            Decimal  @default(0) @db.Decimal(15, 2)
  adminFee          Decimal  @default(0) @map("admin_fee") @db.Decimal(15, 2)
  sellingPrice      Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  profit            Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethodUuid String?  @map("payment_method_uuid") @db.Char(36)
  providerReference String?  @map("provider_reference") @db.VarChar(255)
  provider          String   @db.VarChar(20)
  status            String   @db.VarChar(20)
  providerResponse  Json?    @map("provider_response")
  notes             String?  @db.Text
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company       Company            @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  branch        PosBranch         @relation(fields: [branchUuid], references: [uuid], onDelete: Cascade)
  paymentMethod PosPaymentMethod? @relation(fields: [paymentMethodUuid], references: [uuid], onDelete: SetNull)
  creator       User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([companyUuid])
  @@index([branchUuid])
  @@index([status])
  @@index([createdAt])
  @@map("pos_ppob_transactions")
}
