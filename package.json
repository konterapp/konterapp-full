{
  "name": "konterapp-full",
  "version": "0.27.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts",
    "seed:dummy": "ts-node --project prisma/tsconfig.seed.json prisma/seeders/dummy/index.ts",
    "seed:dummy:file": "ts-node --project prisma/tsconfig.seed.json",
    "seed:branches": "ts-node --project prisma/tsconfig.seed.json prisma/seeders/dummy/branches.ts",
    "check:transactions": "node scripts/check-transactions.js",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:db:push": "prisma db push --config prisma.config.testdb.ts --accept-data-loss --skip-generate"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@sentry/nextjs": "^10.70.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.9.2",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.9",
    "lucide-react": "^0.577.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "browserslist": "^4.28.8",
    "fast-uri": "^3.1.7",
    "@humanfs/node": "^0.16.8"
  }
}
