# ==================================================================
# KONTERAPP - Environment Variables
# Salin file ini menjadi `.env` lalu isi nilai yang dibutuhkan.
# ==================================================================

# ------------------------------------------------------------
# Core / Aplikasi
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/konterapp_full"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/konterapp_full"
# Secret untuk signing token auth (gunakan nilai acak yang panjang di production)
AUTH_SECRET=""
# URL publik aplikasi. Dipakai untuk URL gambar, redirect pembayaran,
# dan hal lain yang butuh alamat app dari sisi browser/server.
NEXT_PUBLIC_APP_URL="http://localhost:3002"
# Login Google (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------------------------
# PPOB - DigiFlazz (https://digiflazz.com)
# ------------------------------------------------------------
DIGIFLAZZ_USERNAME=""
DIGIFLAZZ_API_KEY=""
DIGIFLAZZ_BASE_URL="https://api.digiflazz.com/v1"

# ------------------------------------------------------------
# PPOB - RajaBiller (https://rajabiller.fastpay.co.id)
# ------------------------------------------------------------
RAJABILLER_UID=""
RAJABILLER_PIN=""
RAJABILLER_BASE_URL="https://rajabiller.fastpay.co.id/transaksi/json_devel.php"

# ------------------------------------------------------------
# Keepalive (melindungi endpoint /api/health/db)
# ------------------------------------------------------------
# Pakai nilai yang sama di GitHub secret KEEPALIVE_URL query param (?key=...).
KEEPALIVE_CRON_KEY=""

# ------------------------------------------------------------
# Midtrans Payment Gateway (https://midtrans.com)
# ------------------------------------------------------------
# Aktifkan checkout paket berbayar. Server Key dari dashboard Midtrans
# (SB-Mid-server-... untuk sandbox).
MIDTRANS_SERVER_KEY=""
# "true" untuk production, kosongkan/"false" untuk sandbox
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------
# Sentry Error Monitoring (https://sentry.io)
# ------------------------------------------------------------
# DSN dari Sentry dashboard -> Settings -> Projects -> <project> -> Client Keys
SENTRY_DSN=""
# Opsional: untuk upload source maps saat `next build` (Sentry -> Settings -> Auth Tokens)
SENTRY_AUTH_TOKEN=""
# Opsional: slug org & project (dipakai bersama auth token saat upload source maps)
SENTRY_ORG=""
SENTRY_PROJECT=""
